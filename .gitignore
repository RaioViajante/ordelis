# macOS
.DS_Store

# Python
__pycache__/
/node_modules/
*.py[cod]
*.pyo
*.pyd
build/
dist/
*.egg-info/
.venv-build/

# Local runtime state
.mco/state.json

# Hive workspace / local mcporter config (not part of repo)
/.hive/
/config/mcporter.json

# Temp artifacts
*.tmp

# Local review runs. Historical tracked reports remain tracked.
/reports/review/*/

# Generated CI and dry-run output. Release signoffs under reports/gate remain visible.
/reports/adapter-contract/*/
/reports/dry-run/*/

# Local development interpreter for the dev-runtime bridge (an absolute path; never committed)
/desktop/src-tauri/.dev-python

# Capability probe local homes (HOME/CODEX_HOME pointed into the artifacts root can
# capture shell snapshots, session transcripts and auth state — never committed)
.probe_*_home/

# Codex shell snapshots (verbatim environment of the invoking shell — never committed)
shell_snapshots/

# Raw provider stdout/stderr transcripts from capability probes (may embed environment
# details). Curated probe evidence (result.json, parsed.json, summaries) stays committable.
docs/probes/**/raw/
